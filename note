Translate.jsx

const handleAIChat = (text, languageCode) => {
    if (languageCode) {
      const payload = {
        text: text,
        language_code: languageCode,
        native: nativeLang,
      };
      dispatch(setCurrentWord(payload));
      navigate('/ai-chat', { state: { initialQuery: text } });
    }
  };